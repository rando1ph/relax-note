{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-read-file",
    "log:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
